# Copy to .env and fill in. Never commit .env.

# --- LLM (Claude) ---
LLM_PROVIDER=anthropic                    # anthropic | openrouter
ANTHROPIC_API_KEY=                        # or sign in once with `ant auth login`
OPENROUTER_API_KEY=                       # when LLM_PROVIDER=openrouter
# ANSWER_MODEL=claude-opus-5-5
# FAST_MODEL=claude-haiku-5-5

# --- Google Drive (pick one mode) ---
GOOGLE_AUTH_MODE=service_account          # service_account | oauth
GOOGLE_APPLICATION_CREDENTIALS=           # service account JSON key path
GOOGLE_OAUTH_CLIENT_FILE=                 # OAuth client JSON path
GOOGLE_IMPERSONATE_USER=                  # only for domain-wide delegation
DRIVE_FOLDER_IDS=                         # comma-separated folder URLs or IDs

# --- Embeddings ---
# local = open-source model run on this machine via FastEmbed (default: nomic-embed-text-v1.5)
EMBEDDINGS_PROVIDER=local                 # local | voyage | openai
VOYAGE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
GOOGLE_API_KEY=

# --- Vector store ---
VECTOR_STORE=qdrant                       # qdrant (chroma | pinecone | pgvector planned)
QDRANT_URL=                               # e.g. http://localhost:6333 or your Qdrant Cloud URL;
                                          # empty = embedded on-disk mode in .drive-agent/qdrant
QDRANT_API_KEY=
PINECONE_API_KEY=
DATABASE_URL=                             # pgvector, e.g. postgresql+psycopg://user:pass@host/db

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=                          # Socket Mode only
SLACK_SIGNING_SECRET=                     # HTTP mode only
# SLACK_COMMAND=/drive-agent             # per bot: see `drive-agent bot add`
# SLACK_ALLOWED_CHANNELS=C0123ABC
# SLACK_ALLOW_DMS=false                  # true lets anyone in the workspace DM the bot
# SLACK_ADMIN_USERS=U0123ABC
# SLACK_WATCHDOG=true                    # Socket Mode: reconnect, then restart, when stuck
# SLACK_WATCHDOG_FAILURES=10             # drops or errors in 10 min that count as stuck (0 = disconnects only)
# SLACK_WATCHDOG_GRACE_SECONDS=120       # how long stuck before the watchdog acts

# --- Auto-sync (Slack bot, web app, `sync --watch`) ---
# SYNC_SCHEDULE=0 */6 * * *              # cron, UTC; `off` disables it

# --- Web app ---
UI_PASSWORD=                              # required if the Streamlit app is reachable beyond localhost

# --- Tracing (optional) ---
TRACING_PROVIDER=none                     # none | langsmith | langfuse
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Any setting can also be set as DRIVE_AGENT__<SECTION>__<FIELD>, e.g.
# DRIVE_AGENT__INGEST__CHUNK_TOKENS=600
